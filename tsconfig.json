{
    "compilerOptions": {
        "target": "ES2022",
        "module": "Node16",
        "rootDir": "src",
        "sourceMap": true,
        "outDir": "build",
        "strict": true,
        "alwaysStrict": true,
        "types": ["node"],
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true,
        "skipLibCheck": true,
        "noFallthroughCasesInSwitch": true,
        "allowSyntheticDefaultImports": true,
        "moduleResolution": "Node16",
    },
    "include": ["src/**/*"],
    "exclude": ["node_modules", "build"]
}
